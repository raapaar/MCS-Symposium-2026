rules_version = '2';
// Existing published content: event/presenters/staff/schedule/announcements/documents/gallery/sponsors.
// users: role (staff/admin/superuser), optional email <=254 and active bool. No self-role writes.
// merchandise: title<=120, description<=2000, category<=60, image<=2000,
// priceCents int 0..10000000, published/available bool, paymentInstructions<=2000.
// storeOrders: immutable owner/product/price/quantity/total/createdAt; contact<=254,
// name<=100, note/reviewNote<=1000, receiptPath<=400, role-gated workflow below.
// siteSettings/appearance: bounded colors, image URL, display word and motion/layout settings.
// serviceRegister/handoverRecords: bounded custodianship and secure-vault references; superuser only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) != false
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'customer';
    }
    function staff() { return role() in ['admin', 'staff', 'superuser']; }
    // Staff permissions are assigned only by the superuser. Missing permissions grant no sections.
    function permit(section) {
      return role() in ['admin','superuser'] || (role() == 'staff'
        && section in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', []));
    }
    function orderStaff() { return permit('orders') || permit('payments'); }
    function reservationOpen(d) { return d.createdAt is timestamp && request.time < d.createdAt + duration.value(24, 'h'); }
    function owner() { return role() == 'superuser'; }
    function text(value, size) { return value is string && value.size() <= size; }
    function userValid(d) {
      return d.keys().hasAll(['role']) && d.keys().hasOnly(['role','email','active','permissions'])
        && d.role in ['admin','staff','superuser']
        && (!('email' in d) || text(d.email,254))
        && (!('active' in d) || d.active is bool)
        && (!('permissions' in d) || (d.permissions is list && d.permissions.size() <= 13
          && d.permissions.toSet().hasOnly(['event','presenters','schedule','announcements','gallery','documents','staff','sponsors','merchandise','orders','payments','appearance','enquiries'])));
    }
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || owner();
      allow create: if owner() && uid != request.auth.uid && userValid(request.resource.data)
        && request.resource.data.role in ['staff','admin'];
      allow update: if owner() && uid != request.auth.uid && resource.data.role != 'superuser'
        && userValid(request.resource.data) && request.resource.data.role in ['staff','admin'];
      allow delete: if false;
    }
    match /{content}/{id} {
      allow read: if content in ['event','schedule','presenters','announcements','documents','gallery','sponsors','staff']
        && (resource.data.published == true || permit(content));
      // Preserve existing manager schemas and functionality. New domains below use strict validators.
      allow write: if content in ['event','schedule','presenters','announcements','documents','gallery','sponsors','staff'] && permit(content);
    }
    function productValid(d) {
      return d.keys().hasAll(['title','description','category','image','priceCents','published','available','paymentInstructions'])
        && d.keys().hasOnly(['title','description','category','image','priceCents','published','available','paymentInstructions'])
        && text(d.title,120) && d.title.size() > 0 && text(d.description,2000)
        && text(d.category,60) && text(d.image,2000)
        && (d.image == '' || d.image.matches('https://.*') || d.image.matches('/api/storage/file/merchandise.*'))
        && d.priceCents is int && d.priceCents >= 0 && d.priceCents <= 10000000
        && d.published is bool && d.available is bool && text(d.paymentInstructions,2000);
    }
    match /merchandise/{id} {
      allow read: if resource.data.published == true || permit('merchandise');
      allow create, update: if permit('merchandise') && productValid(request.resource.data);
      allow delete: if false;
    }
    function locationValid(value) {
      return value == null || (value is map && value.keys().hasAll(['latitude','longitude'])
        && value.keys().hasOnly(['latitude','longitude']) && value.latitude is number && value.longitude is number
        && value.latitude >= -90 && value.latitude <= 90 && value.longitude >= -180 && value.longitude <= 180);
    }
    function receiptValid(path, uid, id) {
      let parts = path.split('/');
      return path == '' || (parts.size() == 4 && parts[0] == 'receipts'
        && parts[1] == uid && parts[2] == id && parts[3].matches('[a-f0-9-]{36}'));
    }
    function orderValid(d, id) {
      return d.keys().hasAll(['ownerId','productId','productTitle','unitCents','quantity','totalCents','customerName','contact','note','location','status','receiptPath','reviewNote','reviewedBy','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerId','productId','productTitle','unitCents','quantity','totalCents','customerName','contact','note','location','status','receiptPath','reviewNote','reviewedBy','createdAt','updatedAt'])
        && text(d.ownerId,128) && d.ownerId.size() > 0 && text(d.productId,128) && d.productId.matches('[A-Za-z0-9_-]{1,128}')
        && text(d.productTitle,120) && d.unitCents is int && d.unitCents >= 0 && d.unitCents <= 10000000
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 25
        && d.totalCents is int && d.totalCents == d.unitCents * d.quantity
        && text(d.customerName,100) && d.customerName.size() > 0 && text(d.contact,254) && d.contact.size() > 0
        && text(d.note,1000) && locationValid(d.location)
        && d.status in ['requested','confirmed','awaiting_verification','paid','rejected','fulfilled','cancelled']
        && text(d.receiptPath,400) && receiptValid(d.receiptPath,d.ownerId,id)
        && text(d.reviewNote,1000) && text(d.reviewedBy,128)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function pricedBooking(d) {
      let p = get(/databases/$(database)/documents/merchandise/$(d.productId)).data;
      return p.published == true && p.available == true && d.unitCents == p.priceCents && d.productTitle == p.title;
    }
    function staffTransition(before, after, amount) {
      return (before == 'requested' && after in ['confirmed','cancelled'])
        || (before == 'confirmed' && after == 'cancelled')
        || (before == 'awaiting_verification' && after in ['paid','rejected'])
        || (before == 'paid' && after == 'fulfilled')
        || (before == 'confirmed' && amount == 0 && after == 'fulfilled');
    }
    match /storeOrders/{id} {
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid) || orderStaff();
      allow create: if signedIn() && id.matches('[A-Za-z0-9_-]{1,128}') && orderValid(request.resource.data,id)
        && request.resource.data.ownerId == request.auth.uid && pricedBooking(request.resource.data)
        && request.resource.data.status == 'requested' && request.resource.data.receiptPath == ''
        && request.resource.data.reviewedBy == '' && request.resource.data.reviewNote == '' && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && orderValid(request.resource.data,id)
        && ((resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptPath','status','updatedAt'])
          && reservationOpen(resource.data) && resource.data.status in ['confirmed','rejected'] && request.resource.data.status == 'awaiting_verification'
          && request.resource.data.receiptPath != '')
        || (orderStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedBy','updatedAt'])
          && request.resource.data.reviewedBy == request.auth.uid
          && staffTransition(resource.data.status,request.resource.data.status,resource.data.totalCents)
          && (request.resource.data.status == 'cancelled' || resource.data.status in ['awaiting_verification','paid'] || reservationOpen(resource.data))
          && (!(request.resource.data.status in ['paid','rejected']) || permit('payments'))
          && (request.resource.data.status != 'paid' || resource.data.receiptPath != '')));
      allow delete: if false;
    }
    function appearanceValid(d) {
      return d.keys().hasAll(['accent','surface','heroImageUrl','heroWord','motion','layout','rotationSeconds','useGallery'])
        && d.keys().hasOnly(['accent','surface','heroImageUrl','heroWord','motion','layout','rotationSeconds','useGallery','dwuLogoUrl','mcsLogoUrl','featureImageUrl'])
        && text(d.get('featureImageUrl',''),2000) && (d.get('featureImageUrl','') == '' || d.featureImageUrl.matches('https://.*') || d.featureImageUrl.matches('/api/storage/file/branding.*'))
        && text(d.get('dwuLogoUrl',''),2000) && (d.get('dwuLogoUrl','') == '' || d.dwuLogoUrl.matches('https://.*') || d.dwuLogoUrl.matches('/api/storage/file/branding.*'))
        && text(d.get('mcsLogoUrl',''),2000) && (d.get('mcsLogoUrl','') == '' || d.mcsLogoUrl.matches('https://.*') || d.mcsLogoUrl.matches('/api/storage/file/branding.*'))
        && text(d.accent,7) && d.accent.matches('#[a-fA-F0-9]{6}') && text(d.surface,7) && d.surface.matches('#[a-fA-F0-9]{6}')
        && text(d.heroImageUrl,2000) && (d.heroImageUrl == '' || d.heroImageUrl.matches('https://.*') || d.heroImageUrl.matches('/api/storage/file/branding.*'))
        && text(d.heroWord,16) && d.motion is bool && d.useGallery is bool
        && d.layout in ['spacious','compact'] && d.rotationSeconds is int && d.rotationSeconds >= 6 && d.rotationSeconds <= 30;
    }
    match /siteSettings/appearance {
      allow read: if true; // Explicitly public visual settings; never store secrets here.
      allow create, update: if permit('appearance') && appearanceValid(request.resource.data);
      allow delete: if false;
    }

    // Published FAQ: question<=200, answer<=4000, published bool; section staff writes.
    function enquiryValid(d) {
      return d.keys().hasAll(['question','answer','published']) && d.keys().hasOnly(['question','answer','published'])
        && text(d.question,200) && d.question.size()>0 && text(d.answer,4000) && d.answer.size()>0 && d.published is bool;
    }
    match /enquiries/{id} {
      allow read: if resource.data.published == true || permit('enquiries');
      allow create, update: if permit('enquiries') && enquiryValid(request.resource.data);
      allow delete: if false;
    }
    // Public event progress; manual activeSegment=0 before / 1..4 live / 5 finished.
    function programmeValid(d) {
      return d.keys().hasAll(['mode','activeSegment']) && d.keys().hasOnly(['mode','activeSegment'])
        && d.mode in ['auto','manual'] && d.activeSegment is int && d.activeSegment>=0 && d.activeSegment<=5;
    }
    match /siteSettings/programme {
      allow read: if true;
      allow create, update: if permit('schedule') && programmeValid(request.resource.data);
      allow delete: if false;
    }
    function registerValid(d) {
      return d.keys().hasAll(['title','provider','accountOwner','renewalDate','vaultReference','notes'])
        && d.keys().hasOnly(['title','provider','accountOwner','renewalDate','vaultReference','notes'])
        && text(d.title,160) && d.title.size() > 0 && text(d.provider,160) && d.provider.size() > 0
        && text(d.accountOwner,254) && d.accountOwner.size() > 0 && text(d.renewalDate,10)
        && (d.renewalDate == '' || d.renewalDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && text(d.vaultReference,500) && text(d.notes,4000);
    }
    match /{register}/{id} {
      allow read: if register in ['serviceRegister','handoverRecords'] && owner();
      allow create, update: if register in ['serviceRegister','handoverRecords'] && owner() && registerValid(request.resource.data);
      allow delete: if false;
    }
  }
}
