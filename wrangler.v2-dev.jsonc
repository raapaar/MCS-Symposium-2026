{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcs-symposium-v2-dev",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "mcs-symposium-v2-development"
  },
  "assets": {
    "directory": "./dist-v2",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "bucket_name": "mcs-symposium-v2-dev-media",
      "binding": "mcs_symposium_2026_media"
    },
    {
      "bucket_name": "mcs-symposium-v2-dev-receipts",
      "binding": "PRIVATE_RECEIPTS"
    }
  ]
}
