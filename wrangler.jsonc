{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mcs-symposium-2026",
	"compatibility_date": "2026-09-07",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"r2_buckets": [
		{
			"bucket_name": "mcs-symposium-2026-media",
			"binding": "mcs_symposium_2026_media"
		}
	]
}