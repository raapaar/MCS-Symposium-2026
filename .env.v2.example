# Copy this to .env.v2.local (ignored by Git), or set these six values
# as build variables on the NEW V2 Cloudflare Worker only.
# Copy apiKey and appId as TEXT from Firebase to avoid OCR/transcription errors.
VITE_FIREBASE_API_KEY=COPY_API_KEY_FROM_FIREBASE
VITE_FIREBASE_AUTH_DOMAIN=mcs-symposium-v2-development.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mcs-symposium-v2-development
VITE_FIREBASE_STORAGE_BUCKET=mcs-symposium-v2-development.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=689947459888
VITE_FIREBASE_APP_ID=COPY_APP_ID_FROM_FIREBASE
